{
  "expo": {
    "name": "Hormuud University",
    "slug": "hormuud-university-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/hu-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8FAF9",
        "foregroundImage": "./assets/brand/hu-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "scheme": "hu-app",
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Hormuud University App to authenticate you using Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/brand/hu-mark.png",
      "bundler": "metro"
    }
  }
}
