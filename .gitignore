# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
/.npm-cache/

# Expo
.expo/
/.expo-export-check/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Environment files can contain local credentials and must never be committed.
# Commit example templates only; Expo public variables are still bundled into
# the client and must not contain secrets.
.env
.env.*
!.env.example
!.env.*.example

# Local editor settings
.vscode/
.idea/

# Logs and test output
*.log
coverage/
.eslintcache

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
